# Contact form (app/api/contact/route.js) sends through Resend.
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM=Portfolio <onboarding@resend.dev>

# Optional: Google Tag Manager container ID. Leave empty to disable.
NEXT_PUBLIC_GTM=

# Restricted portfolio at /vault. Visitors sign the terms in
# utils/data/vault-terms.js, then enter the access code, which is checked on
# the server only. VAULT_SESSION_SECRET signs the session cookie; if unset,
# the access code is used. Leave VAULT_ACCESS_CODE empty to keep it closed.
VAULT_ACCESS_CODE=
VAULT_SESSION_SECRET=
# Optional: email this address (through Resend) each time someone signs the
# terms and opens the vault.
VAULT_NOTIFY_EMAIL=

# Book sales. With both set, "Order a copy" opens Stripe Checkout; without
# them it sends an order request through Resend (RESEND_API_KEY + EMAIL_TO).
# Create a Product and a one-time Price in the Stripe dashboard and paste the
# price ID (price_...). STRIPE_SHIP_COUNTRIES is a comma list of ISO codes.
STRIPE_SECRET_KEY=
STRIPE_PRICE_AVIONICS_RESEARCH_METHODS_1=
STRIPE_SHIP_COUNTRIES=US

# Restricted vault: contact rows shown inside the file, and where to fetch
# restricted media when it is not on disk (see private/README.md).
VAULT_CONTACT_EMAIL=
VAULT_CONTACT_PERSONAL_EMAIL=
VAULT_CONTACT_PHONE=
VAULT_MEDIA_URL=
VAULT_MEDIA_TOKEN=
