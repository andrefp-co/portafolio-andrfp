# Contact form (app/api/contact/route.js) sends through Resend.
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM=Portfolio <onboarding@resend.dev>

# Optional: Google Tag Manager container ID. Leave empty to disable.
NEXT_PUBLIC_GTM=

# Restricted portfolio at /vault. The access code is checked on the server
# only. VAULT_SESSION_SECRET signs the session cookie; if unset, the access
# code is used. Leave VAULT_ACCESS_CODE empty to keep the vault closed.
VAULT_ACCESS_CODE=
VAULT_SESSION_SECRET=
